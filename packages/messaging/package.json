{
  "name": "@operantix/messaging",
  "private": true,
  "version": "0.0.0",
  "description": "Kafka producer and consumer adapters for Operantix workloads",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@confluentinc/kafka-javascript": "^1.11.0",
    "@opentelemetry/api": "^1.9.1",
    "@operantix/contracts": "workspace:*",
    "@operantix/telemetry": "workspace:*"
  },
  "devDependencies": {
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@operantix/testing": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "vitest": "^5.0.3"
  }
}
