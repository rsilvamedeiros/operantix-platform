{
  "openapi": "3.1.0",
  "info": {
    "title": "Operantix AI service",
    "version": "0.1.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Live",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Ready",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/classifications": {
      "post": {
        "tags": [
          "classifications"
        ],
        "summary": "Classify text into one of the given labels",
        "operationId": "create_classification_v1_classifications_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClassifyTextRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClassifyTextResponse"
                }
              }
            }
          },
          "400": {
            "description": "The body is invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "The service token is missing or wrong",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "LLM_REFUSED: the model declined",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "502": {
            "description": "LLM_OUTPUT_INVALID or LLM_REJECTED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "LLM_UNAVAILABLE: retry later",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "serviceToken": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ClassifyTextRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Text"
          },
          "labels": {
            "items": {
              "$ref": "#/components/schemas/Label"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 2,
            "title": "Labels"
          },
          "tenant": {
            "$ref": "#/components/schemas/Tenant"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "labels",
          "tenant"
        ],
        "title": "ClassifyTextRequest"
      },
      "ClassifyTextResponse": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "promptVersion": {
            "type": "string",
            "title": "Promptversion"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "usage": {
            "$ref": "#/components/schemas/UsageView"
          }
        },
        "type": "object",
        "required": [
          "label",
          "confidence",
          "promptVersion",
          "model",
          "usage"
        ],
        "title": "ClassifyTextResponse"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "Label": {
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
            "title": "Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "Label"
      },
      "LiveResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "LiveResponse"
      },
      "ReadyResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status"
          },
          "checks": {
            "additionalProperties": {
              "type": "string",
              "enum": [
                "up",
                "down"
              ]
            },
            "type": "object",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadyResponse"
      },
      "Tenant": {
        "properties": {
          "organizationId": {
            "type": "string",
            "format": "uuid",
            "title": "Organizationid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "organizationId"
        ],
        "title": "Tenant"
      },
      "UsageView": {
        "properties": {
          "inputTokens": {
            "type": "integer",
            "title": "Inputtokens"
          },
          "outputTokens": {
            "type": "integer",
            "title": "Outputtokens"
          },
          "costUsd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Costusd",
            "description": "Estimate from list prices; null when unknown"
          },
          "latencyMs": {
            "type": "integer",
            "title": "Latencyms"
          }
        },
        "type": "object",
        "required": [
          "inputTokens",
          "outputTokens",
          "costUsd",
          "latencyMs"
        ],
        "title": "UsageView"
      },
      "ValidationDetails": {
        "properties": {
          "fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Fields"
          }
        },
        "type": "object",
        "required": [
          "fields"
        ],
        "title": "ValidationDetails"
      },
      "ValidationErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "$ref": "#/components/schemas/ValidationDetails"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "details"
        ],
        "title": "ValidationErrorBody"
      }
    },
    "securitySchemes": {
      "serviceToken": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
