{
  "name": "@operantix/workflow-worker",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "start:relay": "node --enable-source-maps dist/relay-main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:load": "vitest run --project load --disableConsoleIntercept",
    "test:coverage": "vitest run --coverage --project unit --project integration"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@opentelemetry/api": "^1.9.1",
    "@operantix/contracts": "workspace:*",
    "@operantix/http-client": "workspace:*",
    "@operantix/messaging": "workspace:*",
    "@operantix/secrets": "workspace:*",
    "@operantix/telemetry": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@operantix/testing": "workspace:*",
    "@swc/core": "^1.16.13",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.3",
    "testcontainers": "^12.2.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
