# Application
NODE_ENV=development
APP_ENV=local
PORT=3000
HEALTH_CHECK_TIMEOUT_MS=2000

# PostgreSQL (M00)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=operantix
# The API connects as a role without superuser/BYPASSRLS (ADR-0017).
DATABASE_USER=operantix_app
DATABASE_PASSWORD=change-me-local-only
# Schema owner, used only by `pnpm --filter @operantix/platform-api db:migrate`.
DATABASE_MIGRATION_USER=operantix
DATABASE_MIGRATION_PASSWORD=change-me-local-only

# Workflow worker (M03) - own role, never the API's (ADR-0018); shares DATABASE_HOST/PORT/NAME
WORKER_DATABASE_USER=operantix_worker
WORKER_DATABASE_PASSWORD=change-me-local-only
WORKER_BATCH_SIZE=5
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_SECONDS=60
WORKER_HTTP_TIMEOUT_MS=10000
# Only for calling local services in development; refused when NODE_ENV=production.
WORKER_HTTP_ALLOW_PRIVATE_NETWORKS=false
WORKER_HTTP_MAX_RESPONSE_BYTES=65536
WORKER_STEP_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_DELAY_MS=2000

# Redis (M00)
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka (M04) - compose.yaml; topics come from infrastructure/docker/kafka/create-topics.sh
KAFKA_BROKERS=localhost:9092

# OpenTelemetry (M07)
OTEL_SERVICE_NAME=operantix-local
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Authentication (M01) - any OIDC provider; values below are placeholders
AUTH_ISSUER=https://auth.example.com/
AUTH_AUDIENCE=operantix-api
AUTH_JWKS_URI=https://auth.example.com/.well-known/jwks.json

# AI (M06 - never commit real keys)
AI_PROVIDER=
AI_API_KEY=
