# Application
NODE_ENV=development
APP_ENV=local
PORT=3000
HEALTH_CHECK_TIMEOUT_MS=2000

# PostgreSQL (M00)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=operantix
# The API connects as a role without superuser/BYPASSRLS (ADR-0017).
DATABASE_USER=operantix_app
DATABASE_PASSWORD=change-me-local-only
# Schema owner, used only by `pnpm --filter @operantix/platform-api db:migrate`.
DATABASE_MIGRATION_USER=operantix
DATABASE_MIGRATION_PASSWORD=change-me-local-only

# Workflow worker (M03) - own role, never the API's (ADR-0018); shares DATABASE_HOST/PORT/NAME
WORKER_DATABASE_USER=operantix_worker
WORKER_DATABASE_PASSWORD=change-me-local-only
WORKER_BATCH_SIZE=5
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_SECONDS=60
WORKER_HTTP_TIMEOUT_MS=10000
# Only for calling local services in development; refused when NODE_ENV=production.
WORKER_HTTP_ALLOW_PRIVATE_NETWORKS=false
WORKER_HTTP_MAX_RESPONSE_BYTES=65536
WORKER_STEP_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_DELAY_MS=2000
# AI service for ai_classify steps (ADR-0028). Unset, those steps fail as not configured.
# The token is the same AI_SERVICE_TOKEN the AI service reads (below).
AI_SERVICE_URL=
WORKER_AI_TIMEOUT_MS=45000

# Redis (M00)
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka (M04) - compose.yaml; topics come from infrastructure/docker/kafka/create-topics.sh
KAFKA_BROKERS=localhost:9092

# Outbox relay (M04, ADR-0021) - own role; shares DATABASE_HOST/PORT/NAME and KAFKA_BROKERS
RELAY_DATABASE_USER=operantix_relay
RELAY_DATABASE_PASSWORD=change-me-local-only
RELAY_BATCH_SIZE=100
RELAY_POLL_INTERVAL_MS=500
RELAY_DELIVERY_TIMEOUT_MS=10000
RELAY_RETENTION_HOURS=72
RELAY_CLEANUP_INTERVAL_MS=60000

# Integration worker (M05) - its own database role, created by postgres/init
INTEGRATION_DATABASE_USER=operantix_integration
INTEGRATION_DATABASE_PASSWORD=change-me-local-only
WEBHOOK_HTTP_ALLOW_PRIVATE_NETWORKS=false

# OpenTelemetry (M07)
OTEL_SERVICE_NAME=operantix-local
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Authentication (M01) - any OIDC provider; values below are placeholders
AUTH_ISSUER=https://auth.example.com/
AUTH_AUDIENCE=operantix-api
AUTH_JWKS_URI=https://auth.example.com/.well-known/jwks.json

# Integration secrets (M05, ADR-0022): id:base64(32 bytes), active key first. Shared by
# platform-api, integration-worker and workflow-worker (connections, ADR-0025).
# Generate one with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEYS=

# AI service (M06, ADR-0026)
AI_SERVICE_ENV=development
AI_SERVICE_PORT=8000
AI_SERVICE_LOG_LEVEL=INFO
# Bearer token for /v1 routes (ADR-0028), at least 32 characters. Unset, every /v1 request is
# refused. Generate one with: openssl rand -base64 32
AI_SERVICE_TOKEN=
# LLM gateway (ADR-0027): fake (no key, not allowed in production) or anthropic.
AI_SERVICE_LLM_PROVIDER=fake
AI_SERVICE_LLM_MODEL=claude-opus-5-5
AI_SERVICE_LLM_TIMEOUT_SECONDS=30
AI_SERVICE_LLM_MAX_RETRIES=2
# Required with the anthropic provider. Never commit a real key.
AI_SERVICE_ANTHROPIC_API_KEY=
