# Application
NODE_ENV=development
APP_ENV=local
PORT=3000
HEALTH_CHECK_TIMEOUT_MS=2000

# PostgreSQL (M00)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=operantix
DATABASE_USER=operantix
DATABASE_PASSWORD=change-me-local-only

# Redis (M00)
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka (M04)
KAFKA_BROKERS=localhost:9092

# OpenTelemetry (M07)
OTEL_SERVICE_NAME=operantix-local
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Authentication (M01 - provider-specific values TBD)
AUTH_ISSUER=
AUTH_AUDIENCE=

# AI (M06 - never commit real keys)
AI_PROVIDER=
AI_API_KEY=
